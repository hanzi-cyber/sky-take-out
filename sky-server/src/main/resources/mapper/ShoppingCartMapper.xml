<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.sky.mapper.ShoppingCartMapper">

    <select id="get" resultType="com.sky.entity.ShoppingCart">
        select * from shopping_cart
        <where>
            <if test="userId != null">and user_id = #{userId}</if>
            <if test="dishId != null">and dish_id = #{dishId}</if>
            <if test="setmealId != null">and setmeal_id = #{setmealId}</if>
            <!-- 口味非空字符串时按具体口味匹配 -->
            <if test="dishFlavor != null and dishFlavor != ''">and dish_flavor = #{dishFlavor}</if>
            <!-- 只有 add 场景(dishId 或 setmealId 不为 null)且口味为空时,才过滤空口味记录;
                 list 场景(只有 userId)不加口味条件,避免有口味的菜品被排除 -->
            <if test="(dishId != null or setmealId != null) and (dishFlavor == null or dishFlavor == '')">
                and (dish_flavor is null or dish_flavor = '')
            </if>
        </where>
    </select>
</mapper>